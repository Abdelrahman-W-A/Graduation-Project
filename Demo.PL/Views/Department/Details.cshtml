@model Demo.PL.ViewModels.DepartmentDetailsViewModel
@{
    ViewData["Title"] = "Department Details";
}

<h1 class="my-5 w-75">Department Details</h1>

<div class="row">
    <div class="form-group col-6">
        <label class="col-form-label">Code</label>
        <input class="form-control" value="@Model.Code" readonly />
    </div>
    <div class="form-group col-6">
        <label class="col-form-label">Name</label>
        <input class="form-control" value="@Model.Name" readonly />
    </div>
    <div class="form-group col-12">
        <label class="col-form-label">Description</label>
        <input class="form-control" value="@Model.Description" readonly />
    </div>
    <div class="form-group col-12">
        <label class="col-form-label">Created On</label>
        <input class="form-control" value="@Model.CreatedOn.ToShortDateString()" readonly />
    </div>
    <div class="form-group col-6">
        <label class="col-form-label">Number of Employees</label>
        <input class="form-control" value="@Model.EmployeeCount" readonly />
    </div>
    <div class="form-group col-6">
        <label class="col-form-label">Total Salaries</label>
        <input class="form-control" value="@Model.TotalSalaries" readonly />
    </div>
</div>

<hr />

<h3>Employees in this Department</h3>
<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Salary</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Employees.Any())
        {
            @foreach (var emp in Model.Employees)
            {
                <tr>
                    <td>@emp.Name</td>
                    <td>@emp.Salary</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">No employees in this department</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-controller="Department" asp-action="Index" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
</div>
