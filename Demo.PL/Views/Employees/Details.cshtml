@using Demo.BLL.Data_Transfer_Objects__DTOs_.EmployeeDTOs
@model GetEmployeeByIdDTO
@{
    ViewData["Title"] = "Details";
}

<h1 class="my-5 w-75">Employee Details</h1>

@if (string.IsNullOrEmpty(Model.ImageName))
{
    <p>No Image Available.</p>
}
else
{
    <div style="width:100%; max-width:200px; aspect-ratio:1/1; border:1px solid #ccc; border-radius:8px; overflow:hidden; margin:20px;">
        <img src="~/Files/Images/@Model.ImageName"
             alt="Employee Image"
             style="width:100%; height:100%; object-fit:cover;"
             class="img-fluid" />
    </div>
}

<!-- Tabs -->
<ul class="nav nav-tabs" id="employeeTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab" aria-controls="general" aria-selected="true">General</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link" id="attendance-tab" data-bs-toggle="tab" href="#attendance" role="tab" aria-controls="attendance" aria-selected="false">Attendance</a>
    </li>
</ul>

<div class="tab-content" id="myTabContent">
    <!-- General Info -->
    <div class="tab-pane fade show active p-4 border" id="general" role="tabpanel" aria-labelledby="general-tab">
        <div class="row">
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Email"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Age"></label>
                <input asp-for="Age" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Address"></label>
                <input asp-for="Address" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Role"></label>
                <input asp-for="Role" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Department"></label>
                <input asp-for="Department" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="HiringDate"></label>
                <input asp-for="HiringDate" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Salary"></label>
                <input asp-for="Salary" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="gender"></label>
                <input asp-for="gender" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="EmployeeType"></label>
                <input asp-for="EmployeeType" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <input asp-for="IsActive" class="form-check-input" disabled />
                <label class="col-form-label" asp-for="IsActive"></label>
            </div>
            @if (!string.IsNullOrEmpty(Model.CvFileName))
            {
                <div class="mb-3">
                    <!-- View CV button (opens in a new tab) -->
                    <a href="~/Files/CVs/@Model.CvFileName" target="_blank" class="btn btn-outline-primary me-2">
                        <i class="bi bi-eye"></i> View CV
                    </a>

                    <!-- Download CV button -->
                    <a asp-action="DownloadCv" asp-route-id="@Model.Id" class="btn btn-outline-success">
                        <i class="bi bi-download"></i> Download CV
                    </a>
                </div>
            }
            else
            {
                <p>No CV uploaded.</p>
            }




        </div>
        <!-- Edit & Back Buttons -->
        <div class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
        </div>
        </br>
        <a asp-action="ExportToPdf" asp-route-id="@Model.Id" class="btn btn-danger">
            <i class="fas fa-file-pdf"></i> Generate Details PDF
        </a>
    </div>



    <!-- Attendance Info -->
    <div class="tab-pane fade p-4 border" id="attendance" role="tabpanel" aria-labelledby="attendance-tab">
            <h5>(Search With Date)</h5>
        <div>
            <form method="get" asp-action="Details" asp-controller="Employees">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="row mb-3">
                    <div class="col-md-3">
						Date From:
                        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                    </div>
                    <div class="col-md-3">
						Date To:
                        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                    </div>
                    <div class="col-md-3">
                        </br>
                        <button type="submit" class="btn btn-primary">Search</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Reset</a>
                    </div>
                </div>
            </form>
        </div>
        <div>
            <a asp-controller="Attendance"
               asp-action="Index"
               asp-route-employeeId="@Model.Id"
               class="btn btn-warning">Details and actions</a>
        </div>
        @if (Model.DailyAttendances != null && Model.DailyAttendances.Any())
        {
            <table class="table table-striped">
                <thead class="text-center">
                    <tr>
                        <th>Date</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var att in Model.DailyAttendances)
                    {
                        <tr>
                            <td>@att.Date.ToString("yyyy-MM-dd")</td>
                            <td>@att.CheckIn</td>
                            <td>@att.CheckOut</td>
                            <td>@(att.IsAbsent ? "Absent" : "Present")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No attendance records available.</p>
        }

        <!-- Optional Add Attendance Button -->
        <div class="mt-3">
            <a asp-controller="Employees"
               asp-action="AddAttendance"
               asp-route-employeeId="@Model.Id"
               class="btn btn-primary">
                Add Attendance
            </a>
            <a asp-action="Index" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
        </div>
    </div>

</div>


