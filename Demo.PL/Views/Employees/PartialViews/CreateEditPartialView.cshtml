@using Demo.BLL.Services.DepartmentServices
@using Demo.DAL.Models.Shared
@using Demo.PL.ViewModels
@model EmployeeViewModel
@inject IDepartmentServices departmentService
@{
    var departments = departmentService.GetAllDepartments() ?? new List<DepartmentDTO>();
    var Departments = new SelectList(departments, "DeptID", nameof(DepartmentDTO.Name));
}

    <!-- Camera / Upload Photo -->
    <div class="col-md-4">
        <label>Employee Photo</label><br />

        <!-- Toggle buttons -->
        <div class="btn-group mb-3" role="group">
            <button type="button" id="cameraChoiceBtn" class="btn btn-outline-primary btn-sm">Use Camera</button>
            <button type="button" id="fileChoiceBtn" class="btn btn-outline-secondary btn-sm">Upload File</button>
        </div>

        <!-- CAMERA SECTION -->
        <div id="cameraSection" style="display:none;">
            <button type="button" id="openCameraBtn" class="btn btn-success btn-sm mb-2">Open Camera</button>
            <video id="video" width="200" height="200" autoplay
                   style="border:1px solid #ccc; object-fit:cover; display:none;"></video>
            <canvas id="canvas" width="200" height="200" style="display:none;"></canvas>
            <button type="button" id="captureBtn" class="btn btn-primary btn-sm mt-2" style="display:none;">Capture</button>
            <input type="hidden" id="capturedImage" name="CapturedImage" />
            <img id="previewCamera" style="margin-top:10px; width:200px; height:200px; object-fit:cover; border:1px solid #ccc; display:none;" />
        </div>

        <!-- FILE UPLOAD SECTION -->
        <div id="fileSection" style="display:none;">
            <label for="Image">Upload New Photo</label>
            <input asp-for="Image" type="file" class="form-control" accept="image/*" />
            <input type="hidden" asp-for="ExistingImageName" />
            <img id="previewFile" style="margin-top:10px; width:200px; height:200px; object-fit:cover; border:1px solid #ccc; display:none;" />
        </div>

        <!-- Existing photo -->
        @if (Model != null && !string.IsNullOrEmpty(Model.ExistingImageName))
        {
            <div class="mt-3">
                <label>Current Photo</label><br />
                <img src="~/Files/Images/@Model.ExistingImageName" style="max-height:150px; border:1px solid #ccc;" />
            </div>
        }
    </div>


<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Name"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Email"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="PhoneNumber"></label>
    <input asp-for="PhoneNumber" class="form-control" />
    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Age"></label>
    <input asp-for="Age" class="form-control" />
    <span asp-validation-for="Age" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Address"></label>
    <input asp-for="Address" class="form-control" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Role"></label>
    <input asp-for="Role" class="form-control" />
    <span asp-validation-for="Role" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="HiringDate"></label>
    <input type="date" asp-for="HiringDate" class="form-control" />
    <span asp-validation-for="HiringDate" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Salary"></label>
    <input asp-for="Salary" step="0.01" max="10000000.00" class="form-control" />
    <span asp-validation-for="Salary" class="text-danger"></span>

</div>
<div class="form-group mb-3 col-6">
    <input asp-for="IsActive" class="form-check-input" />
    <label class="col-form-label" asp-for="IsActive"></label>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="EmployeeType"></label>
    <select class="form-control" asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()"><option value="">Select Employee Type</option></select>
    <span asp-validation-for="EmployeeType" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="DepartmentID"></label>
    <select class="form-control" asp-for="DepartmentID" asp-items="Departments">
        <option value="@null">Select Department</option>
    </select>
    <span asp-validation-for="DepartmentID" class="text-danger"></span>
</div>
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="gender"></label>
    <div>
        @foreach (var genderoption in Enum.GetValues<EmployeeGender>())
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="gender" value="@genderoption" />
                <label class=" form-check-label">@genderoption</label>
            </div>
        }
    </div>
    <span asp-validation-for="gender" class="text-danger"></span>

</div>
    <script>
        // Toggle sections
        const cameraChoiceBtn = document.getElementById('cameraChoiceBtn');
        const fileChoiceBtn = document.getElementById('fileChoiceBtn');
        const cameraSection = document.getElementById('cameraSection');
        const fileSection = document.getElementById('fileSection');

        cameraChoiceBtn.addEventListener('click', () => {
            cameraSection.style.display = 'block';
            fileSection.style.display = 'none';
            cameraChoiceBtn.classList.add('btn-primary');
            fileChoiceBtn.classList.remove('btn-primary');
        });

        fileChoiceBtn.addEventListener('click', () => {
            fileSection.style.display = 'block';
            cameraSection.style.display = 'none';
            fileChoiceBtn.classList.add('btn-primary');
            cameraChoiceBtn.classList.remove('btn-primary');
        });

        // CAMERA LOGIC
        const openBtn = document.getElementById('openCameraBtn');
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const captureBtn = document.getElementById('captureBtn');
        const previewCamera = document.getElementById('previewCamera');
        const capturedInput = document.getElementById('capturedImage');
        let stream = null;

        openBtn.addEventListener('click', async () => {
            if (!stream) {
                try {
                    stream = await navigator.mediaDevices.getUserMedia({ video: true });
                    video.srcObject = stream;
                    video.style.display = "block";
                    captureBtn.style.display = "inline-block";
                    openBtn.textContent = "Close Camera";
                    openBtn.classList.replace("btn-success", "btn-danger");
                } catch (err) {
                    alert("Camera access denied or unavailable.");
                    console.error(err);
                }
            } else {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
                video.style.display = "none";
                captureBtn.style.display = "none";
                openBtn.textContent = "Open Camera";
                openBtn.classList.replace("btn-danger", "btn-success");
            }
        });

        captureBtn.addEventListener('click', () => {
            const context = canvas.getContext('2d');
            context.drawImage(video, 0, 0, canvas.width, canvas.height);
            const dataUrl = canvas.toDataURL('image/png');
            previewCamera.src = dataUrl;
            previewCamera.style.display = "block";
            capturedInput.value = dataUrl;
        });

        // FILE PREVIEW
        const fileInput = document.querySelector('input[name="Image"]');
        const previewFile = document.getElementById('previewFile');

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    previewFile.src = e.target.result;
                    previewFile.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
