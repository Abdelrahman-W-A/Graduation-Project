<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SCS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Demo.PL.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <link rel="icon" type="image/png" href="~/Files/Images/SCS Logo.png" />

    <style>
        /* 🔹 Page transition effect */
        /* Transition effect for page content */


        .page-transition {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

            .page-transition.show {
                opacity: 1;
                transform: translateY(0);
            }


        /* Default small navbar */
        .navbar {
            height: 50px; /* smaller height */
            transition: height 0.3s ease, background-color 0.3s ease;
            overflow: hidden;
        }

            /* When hovered → expand */
            .navbar:hover {
                height: 90px; /* expanded height */
                background-color: #f8f9fa; /* optional: highlight */
            }

            .navbar .navbar-brand img {
                height: 30px;
                transition: height 0.3s ease;
            }

            .navbar:hover .navbar-brand img {
                height: 50px; /* bigger when expanded */
            }

            .navbar .nav-link {
                padding: 0.25rem 0.75rem;
                transition: font-size 0.3s ease;
            }

            .navbar:hover .nav-link {
                font-size: 1.1rem; /* slightly bigger text */
            }


            .logout-btn {
        transition: all 0.2s ease-in-out;
    }
    .logout-btn:hover {
        background-color: #c82333; /* Darker red */
        transform: translateY(-2px); /* Slight lift */
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
			}
        .rocket-logo {
            animation: rocketLaunch 2s ease-in-out infinite alternate;
        }

        @@keyframes rocketLaunch {
            0%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px) rotate(-3deg);
        }

        100% {
            transform: translateY(0);
        }

        }

        .btn-ai:hover {
            background-color: #0b5ed7; /* Darker shade of primary */
            transition: background-color 0.3s, transform 0.2s;
        }

        /* Hover effect */
        /* Base nav link styles */
        .navbar .nav-link {
            position: relative;
            transition: color 0.3s ease, transform 0.2s ease;
            font-weight: 500;
        }

            /* Hover effect */
            .navbar .nav-link:hover {
                color: #0d6efd; /* Bootstrap primary blue */
                transform: scale(1.05);
            }

            /* Underline animation */
            .navbar .nav-link::after {
                content: '';
                position: absolute;
                width: 0;
                height: 2px;
                left: 0;
                bottom: -3px;
                background-color: #0d6efd;
                transition: width 0.3s ease;
            }

            .navbar .nav-link:hover::after,
            .navbar .nav-link.active::after {
                width: 100%;
            }

            /* Keep active link colored */
            .navbar .nav-link.active {
                color: #0d6efd !important;
            }


        body.dark-mode {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }

            body.dark-mode .navbar,
            body.dark-mode footer {
                background-color: #1e1e1e !important;
            }

                body.dark-mode .nav-link,
                body.dark-mode .navbar-brand,
                body.dark-mode footer a,
                body.dark-mode .text-dark {
                    color: #e0e0e0 !important;
                }

                    body.dark-mode .nav-link:hover,
                    body.dark-mode footer a:hover {
                        color: #90caf9 !important;
                    }

            body.dark-mode .border-top {
                border-top-color: #333 !important;
            }

        .dark-mode-toggle {
            background: transparent;
            border: none;
            color: #555;
            font-size: 1.3rem;
            cursor: pointer;
            margin-left: 10px;
            transition: color 0.3s;
        }

            .dark-mode-toggle:hover {
                color: #00bfff;
            }

        body.dark-mode .container {
            color: #e0e0e0 !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Files/Images/SCS Logo.png" alt="SCS Logo" style="height:40px; width:auto; margin-right:8px;" />
                    <span class="fw-bold">SCS</span>
                </a>



                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                             && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employees" ? "active" : "")"
                               asp-controller="Employees" asp-action="Index">Employees</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Department" ? "active" : "")"
                               asp-controller="Department" asp-action="Index">Departments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(
                                                    (ViewContext.RouteData.Values["controller"]?.ToString() == "SalesInvoices" ||
                                                    ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseInvoices" || 
                                                    ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ||
                                                    ViewContext.RouteData.Values["controller"]?.ToString() == "Sellers" ||
                                                    ViewContext.RouteData.Values["controller"]?.ToString() == "Categories")
                               ? "active" : ""
                                                )"
                               asp-controller="SalesInvoices" asp-action="InvoicesIndex">Invoices</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                               asp-controller="Users" asp-action="Index">Users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Policies" ? "active" : "")"
                               asp-controller="Policies" asp-action="Index">Policy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                             && ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")"
                               asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                </div>
             <div>
                <!-- Sidebar Toggle Button -->
                <button class="btn btn-outline-dark" type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#sidebarMenu"
                        aria-controls="sidebarMenu">
                    <i class="bi bi-list"></i>
                </button>
            </div>
            </div>
        </nav>
    </header>
    <!-- Sidebar (Offcanvas) -->
    <div class="offcanvas offcanvas-end d-flex flex-column" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fw-bold" id="sidebarMenuLabel">Dashboard</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <hr class="w-100 my-3" style="border: 1px solid #ccc; opacity: 0.5;" />
        <div class="offcanvas-body text-center flex-grow-1">
            <!-- Clock -->
            <div class="mb-4">
                <h6><i class="bi bi-clock-history"></i> Clock</h6>
                <h4 id="clock" class="fw-bold"></h4>
            </div>

            <!-- Calendar -->
            <div class="mb-4">
                <h6><i class="bi bi-calendar-date"></i> Calendar</h6>
                <h5 id="calendar" class="fw-bold"></h5>
            </div>

            <!-- Weather -->
            <div class="mb-4">
                <h6><i class="bi bi-cloud-sun"></i> Weather</h6>
                <h5 id="weather" class="fw-bold">Loading...</h5>
            </div>

            <!-- Current Location -->
            <div class="mb-4">
                <h6><i class="bi bi-geo-alt"></i> Location</h6>
                <h5 id="location" class="fw-bold">Detecting...</h5>
            </div>

            <hr class="w-100 my-3" style="border: 1px solid #ccc; opacity: 0.5;" />
            <form asp-controller="AiChat" asp-action="Index" method="get" class="w-100 d-flex justify-content-center">
                <button type="submit" class="btn btn-primary btn-ai px-2 py-2 fs-5 d-flex align-items-center justify-content-center">
                    <i class="fas fa-robot me-2"></i>
                    SCS AI Assistant
                </button>
            </form>
            <hr class="w-100 my-3" style="border: 1px solid #ccc; opacity: 0.5;" />
            <form asp-controller="Account" asp-action="Login" method="get" class="w-100 d-flex justify-content-center">
                <button type="submit" class="btn btn-danger px-5 py-2 fs-5">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </button>
            </form>
            <hr class="w-100 my-3" style="border: 1px solid #ccc; opacity: 0.5;" />
        </div>



        <hr class="w-100 my-3" style="border: 1px solid #ccc; opacity: 0.5;" />
        <!-- 🚀 Logo at Bottom with Rocket Effect -->
        <div class="offcanvas-footer text-center p-3">
            <img id="sidebarLogo" src="~/Files/Images/SCS Logo.png" alt="SCS Logo"
                 style="height:60px; width:auto;" class="rocket-logo" />
        </div>

    </div>





    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <div id="pageContent" class="page-transition">
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - SCS. - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>



</body>
</html>
<script>
    function toggleDarkMode() {
        document.body.classList.toggle('dark-mode');

        const icon = document.getElementById('darkModeIcon');
        if (document.body.classList.contains('dark-mode')) {
            localStorage.setItem('theme', 'dark');
            icon.classList.remove('fa-moon');
            icon.classList.add('fa-sun');
        } else {
            localStorage.setItem('theme', 'light');
            icon.classList.remove('fa-sun');
            icon.classList.add('fa-moon');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('theme');
        const icon = document.getElementById('darkModeIcon');
        if (savedTheme === 'dark') {
            document.body.classList.add('dark-mode');
            icon.classList.remove('fa-moon');
            icon.classList.add('fa-sun');
        }
    });

    // Clock
    function updateClock() {
        const now = new Date();
        document.getElementById("clock").innerText = now.toLocaleTimeString();
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Calendar
    function updateCalendar() {
        const now = new Date();
        document.getElementById("calendar").innerText =
            now.toLocaleDateString("en-US", { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }
    updateCalendar();

    // Weather (OpenWeatherMap API)
    async function loadWeather() {
        const apiKey = "0d85e98da3a96eb8f71518e8894f0ae7"; 
        const city = "Cairo"; 
        const url = `https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apiKey}`;

        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error("API error");

            const data = await response.json();
            const temp = data.main.temp.toFixed(1);
            const desc = data.weather[0].description;
            const icon = data.weather[0].icon;

            // 🔹 IMPORTANT: Break the "2x.png" to avoid Razor parsing errors
            document.getElementById("weather").innerHTML =
                '<img src="https://openweathermap.org/img/wn/' + icon + '@@' + '2x.png" ' +
                'alt="Weather Icon" style="height:40px;"/> ' +
                '<span>' + temp + '°C, ' + desc + '</span>';
        } catch (error) {
            document.getElementById("weather").innerText = "Weather unavailable";
        }
    }

    loadWeather();

        // Location (using Geolocation + Reverse Geocoding)
    async function loadLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(async (position) => {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                try {
                    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json`);
                    const data = await response.json();
                    const city = data.address.city || data.address.town || data.address.village || "Unknown City";
                    const country = data.address.country || "Unknown Country";
                    document.getElementById("location").innerText = `${city}, ${country}`;
                } catch (error) {
                    document.getElementById("location").innerText = "Unable to get location";
                }
            }, (error) => {
                document.getElementById("location").innerText = "Location access denied";
            });
        } else {
            document.getElementById("location").innerText = "Geolocation not supported";
        }
    }

    loadLocation();


        document.getElementById('sidebarMenu').addEventListener('shown.bs.offcanvas', () => {
        document.getElementById('sidebarLogo').classList.add('rocket-logo');
    });

    document.getElementById('sidebarMenu').addEventListener('hidden.bs.offcanvas', () => {
        document.getElementById('sidebarLogo').classList.remove('rocket-logo');
    });

    document.addEventListener("DOMContentLoaded", function () {
        const content = document.getElementById("pageContent");
        if (content) {
            setTimeout(() => content.classList.add("show"), 50); // Animate in
        }
    });

    // Smooth transition when navigating
    document.querySelectorAll("a.nav-link, a.btn, a").forEach(link => {
        link.addEventListener("click", function (e) {
            const href = this.getAttribute("href");
            if (href && href.startsWith("http") === false && href !== "#") {
                e.preventDefault();
                const content = document.getElementById("pageContent");
                if (content) {
                    content.classList.remove("show"); // Animate out
                    setTimeout(() => { window.location.href = href; }, 400);
                } else {
                    window.location.href = href;
                }
            }
        });
    });


        // 🔹 Prevent any number input > 1,000,000,000 across the whole system
    document.addEventListener('input', function (e) {
        if (e.target.type === 'number') {
            const MAX_VALUE = 1000000000;
            const val = parseFloat(e.target.value);
            if (val > MAX_VALUE) {
                e.target.value = MAX_VALUE;
                alert("❌ Maximum allowed value is 1,000,000,000");
            }
        }
    });

</script>

@RenderSection("Scripts", required: false)