@model Demo.DAL.Models.Invoice.SalesInvoice.SalesInvoice

@{
    ViewData["Title"] = "Sale Invoice Details";
}

<h2>Sales Invoice Details</h2>

<div class="card mt-3 shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Invoice ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Invoice Code</dt>
            <dd class="col-sm-9">@Model.InvoiceCode</dd>

            <dt class="col-sm-3">Invoice Date</dt>
            <dd class="col-sm-9">@Model.InvoiceDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Client Name</dt>
            <dd class="col-sm-9">@Model.Client?.Name</dd>

            <dt class="col-sm-3">Total Cost</dt>
            <dd class="col-sm-9 fw-bold text-success">@Model.TotalAmount.ToString("C")</dd>
        </dl>
    </div>
</div>

@if (Model.Items != null && Model.Items.Any())
{
    <h4 class="mt-4">Invoice Items</h4>
    <table class="table table-bordered mt-2">
        <thead class="table-light">
            <tr>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Percentage</th>
                <th>Type</th>
                <th>Total Cost</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Category?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@(item.Percentage.HasValue ? $"{item.Percentage.Value} %" : "-")</td>
                    <td>@(item.IsPercentageAdded ? "Added" : "Subtracted")</td>
                    <td>
                        @{
                            var baseTotal = item.Quantity * item.UnitPrice;
                            var percentValue = baseTotal * (item.Percentage / 100);
                            var finalTotal = item.IsPercentageAdded ? baseTotal + percentValue : baseTotal - percentValue;
                        }
                        @string.Format(new System.Globalization.CultureInfo("en-EG"), "{0:C}", finalTotal)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-3">No items found for this invoice.</p>
}

@if (Model.AttachmentData != null)
{
    <div class="mt-3">
        <a asp-action="ViewAttachment" asp-route-id="@Model.Id" class="btn btn-outline-primary" target="_blank">
            <i class="bi bi-eye"></i> View Document
        </a>
        <a asp-action="DownloadAttachment" asp-route-id="@Model.Id" class="btn btn-outline-success">
            <i class="bi bi-download"></i> Download Document
        </a>
    </div>
}
else
{
    <p class="mt-3">No Documents Found.</p>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="InvoicesIndex" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left-circle"></i> Back
    </a>
</div>

<br />
<a asp-action="GeneratePdf" asp-route-id="@Model.Id" class="btn btn-danger">
    <i class="fas fa-file-pdf"></i> Generate PDF
</a>
