@model Demo.PL.ViewModels.SalesInvoiceViewModel

@{
    ViewData["Title"] = "Create Sales Invoice";
    var clients = ViewBag.Clients as SelectList;
    var categories = ViewBag.Categories as SelectList;
}

<h2>Create Sale Invoice</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="form-group mt-2">
        <label asp-for="InvoiceCode">Invoice Code (Optional)</label>
        <input asp-for="InvoiceCode" class="form-control" type="text" />
    </div>

    <div>
        <label asp-for="ClientId" class="form-label">Client Id (Mandatory)</label>
        <select asp-for="ClientId" asp-items="clients" class="form-select" required>
            <option value="">-- Select Client --</option>
        </select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="InvoiceDate" class="form-label">Invoice Date (Mandatory)</label>
        <input asp-for="InvoiceDate" class="form-control" type="date" required />
    </div>

    <div>
        <label for="attachment">Attach File (Optional)</label>
        <input type="file" class="form-control" name="Attachment" />
    </div>

    <hr />
    <h4>Invoice Items (Optional)</h4>

    <table class="table table-bordered" id="itemsTable">
        <thead>
            <tr>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Percentage (%)</th>
                <th>Mode</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <!-- Default first row -->
            <tr>
                <td>
                    <select name="Items[0].CategoryId" class="form-select" asp-items="categories">
                        <option value="">-- Select Category --</option>
                    </select>
                </td>
                <td>
                    <input name="Items[0].Quantity" class="form-control quantity" type="number" min="1" value="1" />
                </td>
                <td>
                    <input name="Items[0].UnitPrice" class="form-control unit-price" type="number" step="0.01" value="0" />
                </td>
                <td>
                    <input name="Items[0].Percentage" class="form-control percentage" type="number" step="0.01" value="0" />
                </td>
                <td>
                    <select name="Items[0].IsPercentageAdded" class="form-select mode">
                        <option value="true">Add (+)</option>
                        <option value="false" selected>Subtract (−)</option>
                    </select>
                </td>
                <td>
                    <input class="form-control subtotal" type="number" readonly />
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>
                </td>
            </tr>
        </tbody>
    </table>

    <button type="button" class="btn btn-outline-primary" id="addRowBtn">+ Add Item</button>

    <div class="mt-3">
        <h5>Total Invoice: <span id="totalAmount">0.00</span></h5>
    </div>

    <div class="mt-3">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="InvoicesIndex" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
    </div>
</form>

@if (ViewBag.Errors != null)
{
    <ul class="text-danger">
        @foreach (var err in ViewBag.Errors)
        {
            <li>@err</li>
        }
    </ul>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let rowIndex = 1;

        // Build category options from Razor
        let categoryOptions = ``;
        @foreach (var cat in categories)
        {
            <text>categoryOptions += `<option value="@cat.Value">@cat.Text</option>`;</text>
        }

        // Add new row
        document.getElementById('addRowBtn').addEventListener('click', () => {
            const table = document.querySelector('#itemsTable tbody');
            const newRow = document.createElement('tr');

            newRow.innerHTML = `
                <td>
                    <select name="Items[${rowIndex}].CategoryId" class="form-select">
                        <option value="">-- Select Category --</option>
                        ${categoryOptions}
                    </select>
                </td>
                <td><input name="Items[${rowIndex}].Quantity" class="form-control quantity" type="number" min="1" value="1" /></td>
                <td><input name="Items[${rowIndex}].UnitPrice" class="form-control unit-price" type="number" step="0.01" value="0" /></td>
                <td><input name="Items[${rowIndex}].Percentage" class="form-control percentage" type="number" step="0.01" value="0" /></td>
                <td>
                    <select name="Items[${rowIndex}].IsPercentageAdded" class="form-select mode">
                        <option value="true">Add (+)</option>
                        <option value="false" selected>Subtract (−)</option>
                    </select>
                </td>
                <td><input class="form-control subtotal" type="number" readonly /></td>
                <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button></td>
            `;
            table.appendChild(newRow);
            rowIndex++;
            reindexRows();
            attachEvents();
            calculateTotals();
        });

        // ✅ Reindex all rows to maintain continuous indices (Items[0], Items[1], …)
        function reindexRows() {
            const rows = document.querySelectorAll('#itemsTable tbody tr');
            rows.forEach((row, i) => {
                row.querySelectorAll('input, select').forEach(input => {
                    const oldName = input.getAttribute('name');
                    if (oldName) {
                        input.setAttribute('name', oldName.replace(/\Items\[\d+\]/, `Items[${i}]`));
                    }
                });
            });
        }

        // Remove row
        function removeRow(button) {
            button.closest('tr').remove();
            reindexRows();  // 🔥 ensure ASP.NET can bind correctly
            calculateTotals();
        }

        // Attach change listeners
        function attachEvents() {
            document.querySelectorAll('.quantity, .unit-price, .percentage, .mode').forEach(input => {
                input.removeEventListener('input', calculateTotals); // avoid duplicates
                input.removeEventListener('change', calculateTotals);
                input.addEventListener('input', calculateTotals);
                input.addEventListener('change', calculateTotals);
            });
        }

        // Calculate totals
        function calculateTotals() {
            let total = 0;
            document.querySelectorAll('#itemsTable tbody tr').forEach(row => {
                const qty = parseFloat(row.querySelector('.quantity')?.value) || 0;
                const price = parseFloat(row.querySelector('.unit-price')?.value) || 0;
                const percent = parseFloat(row.querySelector('.percentage')?.value) || 0;
                const isAdd = row.querySelector('.mode')?.value === "true";

                let subtotal = qty * price;
                if (percent > 0) {
                    const change = subtotal * (percent / 100);
                    subtotal = isAdd ? subtotal + change : subtotal - change;
                }

                row.querySelector('.subtotal').value = subtotal.toFixed(2);
                total += subtotal;
            });
            document.getElementById('totalAmount').innerText = total.toFixed(2);
        }

        // Initialize
        attachEvents();
        calculateTotals();
    </script>
}


