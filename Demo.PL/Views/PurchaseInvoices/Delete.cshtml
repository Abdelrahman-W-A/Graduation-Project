@model Demo.DAL.Models.Invoice.PurchasesInvoice.PurchaseInvoice

@{
    ViewData["Title"] = "Delete Purchase Invoice";
}

<h2>Delete Purchase Invoice</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Client: @Model.Seller?.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Invoice Code</dt>
        <dd class="col-sm-10">@Model.InvoiceCode</dd>

        <dt class="col-sm-2">Invoice Date</dt>
        <dd class="col-sm-10">@Model.InvoiceDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Total Cost</dt>
        <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
    </dl>
</div>

<h4>Invoice Items</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Category</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Percentage</th>
            <th>Type</th>
            <th>Total Cost</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items != null && Model.Items.Any())
        {
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Category?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.Percentage %</td>
                <td>@(item.IsPercentageAdded ? "Added" : "Subtracted")</td>
                <td>@item.Total.ToString("C")</td>
            </tr>
        }
		}
		else
		{
            <tr>
                <td colspan="4" class="text-center">No items found</td>
            </tr>
		}
    </tbody>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="SalesInvoices" asp-action="InvoicesIndex" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
</form>
