@model Demo.DAL.Models.Invoice.PurchasesInvoice.PurchaseInvoice

@{
    ViewData["Title"] = "Edit Purchase Invoice";
    var items = Model.Items?.ToList() ?? new List<Demo.DAL.Models.Invoice.PurchasesInvoice.PurchaseInvoiceItem>();
    var sellers = ViewBag.Sellers as SelectList;
    var categories = ViewBag.Categories as SelectList;
}

<h2>Edit Purchase Invoice</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="InvoiceCode" class="control-label">Invoice Code (Optional)</label>
        <input asp-for="InvoiceCode" class="form-control" />
        <span asp-validation-for="InvoiceCode" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="InvoiceDate" class="control-label">Invoice Date (Mandatory)</label>
        <input asp-for="InvoiceDate" class="form-control" type="date" />
        <span asp-validation-for="InvoiceDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SellerId" class="control-label">Seller (Mandatory)</label>
        <select asp-for="SellerId" class="form-control" asp-items="ViewBag.Sellers"></select>
        <span asp-validation-for="SellerId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TotalAmount" class="control-label">Total Cost (Automated)</label>
        <input asp-for="TotalAmount" class="form-control" id="TotalAmount" readonly />
        <span asp-validation-for="TotalAmount" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label for="attachment">Attach File (Optional)</label>
        <input type="file" class="form-control" name="attachment" />
    </div>

    <hr />
    <h4>Invoice Items</h4>

    <table class="table table-bordered" id="itemsTable">
        <thead>
            <tr>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Percentage</th>
                <th>Operation</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < items.Count; i++)
            {
                var baseTotal = items[i].Quantity * items[i].UnitPrice;
                var final = baseTotal;
                if (items[i].Percentage.HasValue)
                {
                    var percentValue = baseTotal * (items[i].Percentage.Value / 100);
                    final = items[i].IsPercentageAdded ? baseTotal + percentValue : baseTotal - percentValue;
                }

                <tr>
                    <td>
                        <select name="Items[@i].CategoryId" class="form-control" asp-items="ViewBag.Categories" required>
                            <option value="">-- Select Category --</option>
                            <option value="@items[i].CategoryId" selected>@items[i].Category?.Name</option>
                        </select>
                    </td>
                    <td>
                        <input name="Items[@i].Quantity" value="@items[i].Quantity" class="form-control qty" type="number" min="1" required />
                    </td>
                    <td>
                        <input name="Items[@i].UnitPrice" value="@items[i].UnitPrice" class="form-control price" type="number" step="0.01" required />
                    </td>
                    <td>
                        <input name="Items[@i].Percentage" value="@items[i].Percentage" class="form-control percent" type="number" step="0.01" min="0" max="100" />
                    </td>
                    <td>
                        <select name="Items[@i].IsPercentageAdded" class="form-control operation">
                            <option value="true" selected="@(items[i].IsPercentageAdded ? "selected" : null)">Add (+)</option>
                            <option value="false" selected="@(!items[i].IsPercentageAdded ? "selected" : null)">Subtract (-)</option>
                        </select>
                    </td>
                    <td class="item-total">@final.ToString("0.00")</td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>
                    </td>

                    <input type="hidden" name="Items[@i].Id" value="@items[i].Id" />
                    <input type="hidden" name="Items[@i].PurchaseInvoiceId" value="@Model.Id" />
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-outline-primary" id="addRowBtn">Add Item</button>
    <br /><br />
    <button type="submit" class="btn btn-warning">Edit</button>
    <a asp-controller="SalesInvoices" asp-action="InvoicesIndex" asp-fragment="purchases" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left-circle"></i> Back
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        let rowIndex = @items.Count;

        // Add new row dynamically
        document.getElementById('addRowBtn').addEventListener('click', () => {
            const tableBody = document.querySelector('#itemsTable tbody');
            const newRow = document.createElement('tr');

            let options = ``;
        @foreach (var cat in ViewBag.Categories as SelectList)
        {
            <text>options += `<option value="@cat.Value">@cat.Text</option>`;</text>
        }

            newRow.innerHTML = `
                <td><select name="Items[${rowIndex}].CategoryId" class="form-control" required>
                    <option value="">-- Select Category --</option>
                    ${options}
                </select></td>
                <td><input name="Items[${rowIndex}].Quantity" class="form-control qty" type="number" min="1" value="1" required /></td>
                <td><input name="Items[${rowIndex}].UnitPrice" class="form-control price" type="number" step="0.01" value="0" required /></td>
                <td><input name="Items[${rowIndex}].Percentage" class="form-control percent" type="number" step="0.01" min="0" max="100" value="0" /></td>
                <td>
                    <select name="Items[${rowIndex}].IsPercentageAdded" class="form-control operation">
                        <option value="true">Add</option>
                        <option value="false">Subtract</option>
                    </select>
                </td>
                <td class="item-total">0.00</td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>
                </td>
                <input type="hidden" name="Items[${rowIndex}].Id" value="0" />
                <input type="hidden" name="Items[${rowIndex}].PurchaseInvoiceId" value="@Model.Id" />
            `;
            tableBody.appendChild(newRow);
            rowIndex++;
            updateTotal();
        });

        // Remove item row
        function removeRow(button) {
            button.closest('tr').remove();
            updateTotal();
        }

        // Update totals when values change
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('qty') ||
                e.target.classList.contains('price') ||
                e.target.classList.contains('percent') ||
                e.target.classList.contains('operation')) {
                updateTotal();
            }
        });

        function updateTotal() {
            let grandTotal = 0;

            document.querySelectorAll('#itemsTable tbody tr').forEach(row => {
                const qty = parseFloat(row.querySelector('.qty')?.value) || 0;
                const price = parseFloat(row.querySelector('.price')?.value) || 0;
                const percent = parseFloat(row.querySelector('.percent')?.value) || 0;
                const op = row.querySelector('.operation')?.value === "true";

                let baseTotal = qty * price;
                let percentValue = baseTotal * (percent / 100);
                let final = op ? baseTotal + percentValue : baseTotal - percentValue;

                row.querySelector('.item-total').innerText = final.toFixed(2);
                grandTotal += final;
            });

            document.getElementById('TotalAmount').value = grandTotal.toFixed(2);
        }

        updateTotal();
    </script>
}