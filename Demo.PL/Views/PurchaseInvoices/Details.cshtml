@model Demo.DAL.Models.Invoice.PurchasesInvoice.PurchaseInvoice

@{
    ViewData["Title"] = "Purchase Invoice Details";
}

<h2>Purchase Invoice Details</h2>

<div class="card mt-3 shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Invoice ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Invoice Code</dt>
            <dd class="col-sm-9">@Model.InvoiceCode</dd>

            <dt class="col-sm-3">Invoice Date</dt>
            <dd class="col-sm-9">@Model.InvoiceDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Seller Name</dt>
            <dd class="col-sm-9">@Model.Seller?.Name</dd>

            <dt class="col-sm-3">Total Cost</dt>
            <dd class="col-sm-9 fw-bold text-success">@Model.TotalAmount.ToString("C")</dd>
        </dl>
    </div>
</div>
@if (Model.Items == null || !Model.Items.Any())
{
    <p class="mt-3">No items found for this invoice.</p>
}
else
{
<br />
<h4>Invoice Items</h4>
<table class="table table-bordered mt-2">
    <thead class="table-light">
        <tr>
            <th>Category</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Percentage</th>
            <th>Type</th>
            <th>Total Cost</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            var baseTotal = item.Quantity * item.UnitPrice;
            var percentageValue = baseTotal * (item.Percentage / 100);
            var finalTotal = item.IsPercentageAdded ? baseTotal + percentageValue : baseTotal - percentageValue;

            <tr>
                <td>@item.Category?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.Percentage %</td>
                <td>@(item.IsPercentageAdded ? "Added" : "Subtracted")</td>
                <td>@(string.Format("{0:C2}", finalTotal ?? 0))</td>
            </tr>
        }
    </tbody>
</table>
}
@if (Model.AttachmentData != null)
{
    <a asp-action="ViewAttachment" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-eye"></i> View Document</a>
    <a asp-action="DownloadAttachment" asp-route-id="@Model.Id" class="btn btn-outline-success"><i class="bi bi-download"></i> Download Document</a>
}
else
{
    <p class="mt-3">No Documents Found.</p>
}
<br/>
<br />
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-controller="SalesInvoices" asp-action="InvoicesIndex" asp-fragment="Purchases" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
<br />
<br />
<a asp-action="GeneratePdf" asp-route-id="@Model.Id" class="btn btn-danger" target="_blank">
    <i class="fas fa-file-pdf"></i> Generate PDF
</a>
