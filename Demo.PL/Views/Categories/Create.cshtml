@model Demo.DAL.Models.Category.Category

<h2>Create Category</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <!-- Name -->
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- Category Type -->
    <div class="form-group mt-2">
        <label asp-for="CategoryType"></label>
        <select asp-for="CategoryType" class="form-control" id="CategoryTypeSelect"
                asp-items="Html.GetEnumSelectList<Demo.DAL.CategoryTypes>()">
            <option value="">Select Category Type</option>
        </select>
        <span asp-validation-for="CategoryType" class="text-danger"></span>
    </div>

    <!-- AmountNumber (hidden initially) -->
    <div class="form-group mt-2" id="AmountNumberField" style="display:none;">
        <label asp-for="AmountNumber"></label>
        <input asp-for="AmountNumber" class="form-control" type="number" step="0.01" id="AmountNumber" />
        <span asp-validation-for="AmountNumber" class="text-danger"></span>
    </div>

    <!-- Buttons -->
    <button type="submit" class="btn btn-primary mt-3">Create</button>
    <a asp-action="Index" class="btn btn-outline-dark mt-3">
        <i class="bi bi-arrow-left-circle"></i> Back
    </a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Toggle AmountNumber field visibility based on CategoryType
        function toggleAmountField() {
            var type = document.getElementById("CategoryTypeSelect").value;
            var field = document.getElementById("AmountNumberField");
            var input = document.getElementById("AmountNumber");

            if (type === "2") { // Sold = 2
                field.style.display = "block";
                input.disabled = false;
            } else {
                field.style.display = "none";
                input.value = "";
                input.disabled = true;
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleAmountField(); // run once on page load
            document.getElementById("CategoryTypeSelect")
                .addEventListener("change", toggleAmountField);
        });
    </script>
}
