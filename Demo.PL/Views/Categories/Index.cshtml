@using Demo.DAL
@model IEnumerable<Demo.DAL.Models.Category.Category>

@{
    ViewData["Title"] = "Categories";
}

<h2>Categories</h2>
@if (TempData["DeleteError"] != null)
{
    <div class="alert alert-danger">
        @TempData["DeleteError"]
    </div>
}
@if (TempData["DeleteSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["DeleteSuccess"]
    </div>
}
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Category</a>
</p>
<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Search by name..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-bordered">
    <thead>
        <tr class="text-center">
            <th>Id</th>
            <th>Name</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Edit</th>
            <th>Delete</th>

        </tr>
    </thead>
    <tbody class="text-center">
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    There are no categories.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr class="@(item.CategoryType == CategoryTypes.Purchased ? "table-danger" : "table-success")">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.CategoryType</td>
                    <td>@item.AmountNumber</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    </td>
                    <td>
                        <!-- Trigger modal instead of direct delete -->
                        <a href="#"
                           class="btn btn-sm btn-danger"
                           data-bs-toggle="modal"
                           data-bs-target="#deleteModal"
                           data-id="@item.Id"
                           data-name="@item.Name">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

