@using Demo.BLL.Data_Transfer_Objects__DTOs_.EmployeeDTOs
@using Demo.BLL.Data_Transfer_Objects__DTOs_.UserDTOs
@model UsersDetails
@{
    ViewData["Title"] = "Details";
}

<h1 class="my-5 w-75">User Details</h1>

<ul class="nav nav-tabs" id="UserTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab" aria-controls="general" aria-selected="true">General</a>
    </li>
</ul>

    <!-- General Tab Content -->
    <div class="tab-pane fade show active p-4 border" id="general" role="tabpanel" aria-labelledby="general-tab">

        <div class="row">
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Id"></label>
                <input asp-for="Id" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="FName"></label>
                <input asp-for="FName" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="LName"></label>
                <input asp-for="LName" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="Email"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            <div class="form-group mb-3 col-6">
                <label class="form-label" asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" readonly />
            </div>
            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
            </div>
        </div>
    </div>
