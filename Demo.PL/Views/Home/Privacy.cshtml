    <style>
        footer {
            margin-top: 30px;
            padding: 20px;
            text-align: center;
            background: linear-gradient(to right, #f0f0f0, #e8e8e8);
            color: #333;
            font-size: 18px;
            border-top: 2px solid #ddd;
            position: relative;
            overflow: hidden;
        }

        .rocket-container {
            position: absolute;
            top: -20px;
            left: 0;
            width: 100%;
            height: 50px;
            overflow: hidden;
        }

        .rocket {
            font-size: 30px;
            color: #ff5722;
            position: absolute;
            animation: rocket-fly 6s linear infinite;
        }

        @@keyframes rocket-fly {
            0%

        {
            left: -50px;
            top: 0;
            transform: rotate(45deg);
        }

        50% {
            top: -30px;
        }

        100% {
            left: 100%;
            top: 0;
            transform: rotate(45deg);
        }

        }</style>
