@model IEnumerable<Demo.DAL.Models.Client.Client>

<h1>Clients</h1>
    <a class="btn btn-primary mb-3" asp-action="Create">Create Client</a>
<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Search by name..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>
@if (TempData["DeleteError"] != null)
{
    <div class="alert alert-danger">
        @TempData["DeleteError"]
    </div>
}
@if (TempData["DeleteSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["DeleteSuccess"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info mt-3">
        There are no clients.
    </div>
}
else
{

    <table class="table table-striped">
        <thead class="text-center">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Category</th>
                <th>Type</th>
                <th>Details</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.Name</td>
                    <td>@client.PhoneNumber</td>
                    <td>@client.Address</td>
                    <td>@client.Category?.Name</td>
                    <td>@client.Category?.CategoryType</td>
                    <td>
                        <a asp-controller="Clients" asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i> Details
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@client.Id">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@client.Id">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4">
    <a asp-controller="SalesInvoices" asp-action="InvoicesIndex" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left-circle"></i> Back
    </a>
</div>
