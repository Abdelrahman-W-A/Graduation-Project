@model Demo.DAL.Models.Client.Client
@{
    ViewData["Title"] = "Delete Client";
}

<h1>Delete Client</h1>

<h4>Are you sure you want to delete this client?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Category?.Name</dd>
    </dl>
</div>

<div>
    <br/>
    <form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-dark"><i class="bi bi-arrow-left-circle"></i> Back</a>
    </form>
</div>
